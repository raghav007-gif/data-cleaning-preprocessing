import pandas as pd

from google.colab import files
uploaded = files.upload()

file_name = next(iter(uploaded))
df = pd.read_csv(file_name)

print("Dataset shape:", df.shape)

print("\nMissing values:")
print(df.isnull().sum())

print("\nDuplicate Customer IDs:", df["Customer_ID"].duplicated().sum())

# Remove duplicate customer records
df = df.drop_duplicates(subset="Customer_ID")

# Standardize Gender values
df["Gender"] = df["Gender"].str.strip().str.title()

# Standardize City values
df["City"] = df["City"].str.strip().str.title()

# Clean Income values
df["Income"] = df["Income"].astype(str).str.replace(",", "", regex=False)
df["Income"] = pd.to_numeric(df["Income"], errors="coerce")

# Convert Purchase Amount to numeric
df["Purchase_Amount"] = pd.to_numeric(
    df["Purchase_Amount"], errors="coerce"
)

# Convert mixed Purchase Date formats
df["Purchase_Date"] = pd.to_datetime(
    df["Purchase_Date"].astype(str).str.replace("/", "-", regex=False),
    format="mixed",
    errors="coerce"
)

# Fill missing numerical values with median
for column in ["Age", "Income", "Purchase_Amount"]:
    df[column] = df[column].fillna(df[column].median())

# Fill missing categorical values with mode
for column in ["Gender", "City", "Category"]:
    df[column] = df[column].fillna(df[column].mode()[0])

# Verification
print("\nMissing values after cleaning:")
print(df.isnull().sum())

print("\nDuplicate Customer IDs after cleaning:")
print(df["Customer_ID"].duplicated().sum())

# Save cleaned dataset
df.to_csv("cleaned_customer_data.csv", index=False)

print("\nCleaned dataset saved successfully.")
